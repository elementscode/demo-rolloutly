import "./style.css";
import { Badge } from "@elements/ui/badge";
import { EnvState } from "#app/shared/services/models";
import { healthVariant } from "#app/shared/format";

<HealthBadge (env: EnvState)>
  <Badge variant={healthVariant(env.health)}
         dot
         class="health-badge"
         attrs={{ title: `${env.latencyMs}ms p95 · ${env.errorRate.toFixed(2)}% errors` }}>
    {env.health}
  </Badge>
</HealthBadge>
