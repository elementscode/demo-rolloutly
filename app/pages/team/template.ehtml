import "./style.css";
import { sql, ValidationError } from "@elements/app";
import favicon from "#app/shared/assets/favicons/favicon.svg";
import { Layout } from "#app/shared/templates/layout";
import { Alert } from "@elements/ui/alert";
import { Badge } from "@elements/ui/badge";
import { Button } from "@elements/ui/button";
import { Card, CardContent } from "@elements/ui/card";
import { Field } from "@elements/ui/field";
import { Input } from "@elements/ui/input";
import { NativeSelect } from "@elements/ui/native-select";
import { Table, TableCell, TableHead } from "@elements/ui/table";
import { CurrentUser, requireAdminOrThrow, Role } from "#app/shared/services/auth";
import { timeAgo } from "#app/shared/format";

export interface Member {
  id: string;
  name: string;
  email: string;
  role: Role;
  deploys: number;
  lastDeployAt: Date | null;
}

interface MemberForm {
  name: string;
  email: string;
  password: string;
  role: Role;
  error: string;
}

export function loadTeam(): Member[] {
  return sql<Member>(`
    select u.id, u.name, u.email, u.role,
           count(d.id)::int as deploys,
           max(d.createdAt) as lastDeployAt
      from users u
      left join deploys d on d.userId = u.id
     group by u.id
     order by u.role desc, u.name
  `).all();
}

/** @rpc */
export function setRole(userId: string, role: Role): Member[] {
  let admin = requireAdminOrThrow();

  if (userId === admin.id) {
    throw new ValidationError("you cannot change your own role");
  }

  if (role !== "admin" && role !== "engineer") {
    throw new ValidationError("pick a role");
  }

  sql(`update users set role = ${role} where id = ${userId}`);

  return loadTeam();
}

/** @rpc */
export function addMember(form: MemberForm): Member[] {
  requireAdminOrThrow();

  let email = form.email.trim().toLowerCase();
  let name = form.name.trim();

  if (!name) {
    throw new ValidationError("enter a name");
  }

  if (!/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(email)) {
    throw new ValidationError("enter a valid email address");
  }

  if (form.password.length < 8) {
    throw new ValidationError("the password needs at least 8 characters");
  }

  if (!sql(`select 1 from users where email = ${email}`).empty()) {
    throw new ValidationError("that email already has an account");
  }

  sql(`
    insert into users (name, email, role, passwordHash)
         values (${name}, ${email}, ${form.role}, crypt(${form.password}, genSalt('bf', 12)))
  `);

  return loadTeam();
}

function onRole(members: { list: Member[]; error: string }, member: Member, role: Role) {
  try {
    members.list = setRole(member.id, role);
    members.error = "";
  } catch (err: any) {
    members.error = err.message;
  }
}

function onAdd(members: { list: Member[]; error: string }, form: MemberForm) {
  try {
    members.list = addMember(form);
    form.name = "";
    form.email = "";
    form.password = "";
    form.role = "engineer";
    form.error = "";
  } catch (err: any) {
    form.error = err.message;
  }
}

<html lang="en" class="page-team" (
  user: CurrentUser,
  initial: Member[],
  private members: { list: Member[]; error: string } = { list: initial, error: "" },
  private form: MemberForm = { name: "", email: "", password: "", role: "engineer" as Role, error: "" },
  private now: Date = new Date(),
)>
  <head>
    <title>Team · rolloutly</title>
    <meta name="description" content="Accounts and roles">
    <link rel="icon" type="image/svg+xml" href={favicon} />
  </head>
  <body>
    <Layout {user} active="team">
      <div class="team stack is-xl">
        <div class="stack is-xs">
          <h1>Team</h1>
          <p class="text-sm">Engineers deploy and roll back. Admins also manage accounts here.</p>
        </div>

        <Card>
          <CardContent class="stack">
            <Alert e:if={members.error} variant="danger" description={members.error} />
            <Table label="Accounts">
              <table>
                <thead>
                  <tr>
                    <TableHead>Name</TableHead>
                    <TableHead class="team-wide" align="end">Deploys</TableHead>
                    <TableHead class="team-wide">Last deploy</TableHead>
                    <TableHead>Role</TableHead>
                  </tr>
                </thead>
                <tbody>
                  <tr e:for={m of members.list} e:key={(m) => m.id}>
                    <TableCell>
                      <div>{m.name}</div>
                      <div class="team-sub">{m.email}</div>
                    </TableCell>
                    <TableCell class="team-wide" align="end">{m.deploys}</TableCell>
                    <TableCell class="team-wide">{timeAgo(m.lastDeployAt, now)}</TableCell>
                    <TableCell>
                      <Badge e:if={m.id === user.id} variant="accent">{m.role} (you)</Badge>
                      <NativeSelect e:else
                                    size="sm"
                                    value={m.role}
                                    attrs={{ "aria-label": `Role for ${m.name}` }}
                                    onchange={(e) => onRole(members, m, (e.target as HTMLSelectElement).value as Role)}>
                        <option value="engineer">engineer</option>
                        <option value="admin">admin</option>
                      </NativeSelect>
                    </TableCell>
                  </tr>
                </tbody>
              </table>
            </Table>
          </CardContent>
        </Card>

        <Card title="Add an account" level={2}>
          <form class="card-body team-form" onsubmit={() => onAdd(members, form)}>
            <Field label="Name" required>
              <Input value={form.name} attrs={{ autocomplete: "off" }} />
            </Field>
            <Field label="Email" required>
              <Input type="email" value={form.email} attrs={{ autocomplete: "off", autocapitalize: "none", spellcheck: "false" }} />
            </Field>
            <Field label="Password" required>
              <Input type="password" value={form.password} attrs={{ autocomplete: "new-password", minlength: 8 }} />
            </Field>
            <Field label="Role">
              <NativeSelect value={form.role} block>
                <option value="engineer">engineer</option>
                <option value="admin">admin</option>
              </NativeSelect>
            </Field>
            <Alert e:if={form.error} variant="danger" description={form.error} class="team-form-actions" />
            <div class="team-form-actions row">
              <Button type="submit" variant="primary">Add account</Button>
            </div>
          </form>
        </Card>
      </div>
    </Layout>
  </body>
</html>
