import "./style.css";
import { redirect } from "@elements/app";
import { DemoLogin, signin } from "#app/shared/services/auth";
import { Alert } from "@elements/ui/alert";
import { Badge } from "@elements/ui/badge";
import { Button } from "@elements/ui/button";
import { Card } from "@elements/ui/card";
import { Field } from "@elements/ui/field";
import { Input } from "@elements/ui/input";
import { Item, ItemContent, ItemDescription, ItemGroup, ItemTitle } from "@elements/ui/item";

interface SigninForm {
  email: string;
  password: string;
  error: string;
  busy: boolean;
}

function onSubmit(form: SigninForm) {
  form.busy = true;

  try {
    signin(form.email, form.password);
    form.error = "";
    redirect("/");
  } catch (err: any) {
    form.error = err.message;
    form.busy = false;
  }
}

function onPick(form: SigninForm, login: DemoLogin) {
  form.email = login.email;
  form.password = login.password;
  onSubmit(form);
}

<html lang="en" class="page-signin" (
  logins: DemoLogin[],
  private form: SigninForm = { email: "", password: "", error: "", busy: false },
)>
  <head>
    <title>Sign in · rolloutly</title>
    <meta name="description" content="Sign in to rolloutly">
  </head>
  <body>
    <main class="signin-main">
      <div class="signin-panel">
        <form class="signin-form stack is-lg" onsubmit={() => onSubmit(form)}>
          <div class="signin-brand row">
            <svg width="26" height="26" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <rect width="24" height="24" rx="6" fill="currentColor"/>
              <path d="M6 15.5 L10.5 11 L13.5 14 L18 8.5" stroke="var(--accent-ink)" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
            </svg>
            rolloutly
          </div>

          <div class="stack is-xs">
            <h1>Sign in</h1>
            <p class="text-sm">Deploys, rollbacks and health for every service.</p>
          </div>

          <Alert e:if={form.error} variant="danger" description={form.error} />

          <Field label="Email" required>
            <Input type="email"
                   name="email"
                   value={form.email}
                   placeholder="you@rolloutly.dev"
                   attrs={{ id: "email", autocomplete: "email", autocapitalize: "none", spellcheck: "false" }} />
          </Field>

          <Field label="Password" required>
            <Input type="password"
                   name="password"
                   value={form.password}
                   attrs={{ id: "password", autocomplete: "current-password" }} />
          </Field>

          <Button type="submit" variant="primary" block loading={form.busy}>Sign in</Button>
        </form>

        <Card title="Demo accounts" level={2}>
          <ItemGroup label="Demo accounts">
            <Item e:for={login of logins} onclick={() => onPick(form, login)}>
              <ItemContent>
                <ItemTitle>
                  {login.name}
                  <Badge variant={login.role === "admin" ? "accent" : "secondary"}>{login.role}</Badge>
                </ItemTitle>
                <ItemDescription>{login.email} / {login.password}</ItemDescription>
              </ItemContent>
            </Item>
          </ItemGroup>
        </Card>
      </div>
    </main>
  </body>
</html>
